# ---- Gym Tracker environment ----
# Copy to .env for local development. On Railway, set these in the service "Variables" tab.

# Postgres connection string.
# On Railway: add a Postgres database and reference its DATABASE_URL here (or use ${{Postgres.DATABASE_URL}}).
# Locally: leave BLANK to use the built-in PGlite file database (./.data) — no setup required.
DATABASE_URL=

# Secret used to sign login tokens. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables AI analysis of progress photos using Claude vision.
# Leave blank to disable the feature gracefully.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for photo analysis (defaults to the
# latest Claude Opus model).
ANTHROPIC_MODEL=

# Optional: override the default seeded credentials (defaults: Robert / 1).
SEED_USERNAME=Robert
SEED_PASSWORD=1

# Port (Railway sets this automatically; default 3000 locally).
PORT=3000
